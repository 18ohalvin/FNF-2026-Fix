NODE_ENV="development"
PORT="7070"

# ====================================================
# Database Provider Configuration (PostgreSQL / MySQL / SQLite)
# ====================================================
# DB_CLIENT: 'postgres' | 'mysql' | 'sqlite' (defaults to 'sqlite' if DATABASE_URL is not set)
DB_CLIENT="sqlite"

# 1. PostgreSQL (Supabase / Neon / AWS RDS / Railway / Render)
# DATABASE_URL="postgresql://postgres.user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# 2. MySQL (AWS RDS / DigitalOcean / PlanetScale)
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/fix_707_db"

# 3. Local SQLite File (Default for zero-config local development)
DB_PATH="./data/database.sqlite"

# ====================================================
# Application Metadata & Support
# ====================================================
VITE_APP_NAME="FIX 707 Form"
VITE_APP_VERSION="1.0.0"
VITE_API_BASE_URL=""
VITE_WHATSAPP_SUPPORT_NUMBER="6281707909707"
